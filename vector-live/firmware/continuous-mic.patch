+// Bounded, opt-in SDK microphone transport. No recording or cloud job is created.
+#ifndef VECTOR_SDK_MIC_QUEUE_H
+#define VECTOR_SDK_MIC_QUEUE_H
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <vector>
+namespace Anki { namespace Vector { namespace MicData {
+class SDKMicQueue {
+public:
+  using Clock = std::chrono::steady_clock;
+  struct Block {
+    std::array<int16_t, 160> samples;
+    uint32_t timestamp;
+    uint32_t session;
+    uint32_t sequence;
+  };
+  static constexpr size_t kMaxBlocks = 50; // At most 500 ms / 16 KB of PCM.
+  void Renew(uint32_t session, bool enabled, Clock::time_point now = Clock::now()) {
+    std::lock_guard<std::mutex> lock(_mutex);
+    if (!enabled) { _enabled = false; _blocks.clear(); return; }
+    if (session != _session) {
+      _session = session; _sequence = 0; _failed = false; _enabled = false; _blocks.clear();
+    }
+    if (_enabled && now >= _expires) Fail();
+    // A failed lease/overflow stays latched until a new session explicitly starts.
+    if (_failed) return;
+    _enabled = true;
+    _expires = now + std::chrono::seconds(3);
+  }
+  void Push(const int16_t* samples, size_t count, uint32_t timestamp,
+            Clock::time_point now = Clock::now()) {
+    std::lock_guard<std::mutex> lock(_mutex);
+    if (!Check(now)) return;
+    if (count != 160 || _blocks.size() >= kMaxBlocks) { Fail(); return; }
+    Block block;
+    std::copy(samples, samples + count, block.samples.begin());
+    block.timestamp = timestamp; block.session = _session; block.sequence = _sequence++;
+    _blocks.push_back(std::move(block));
+  }
+  std::vector<Block> Drain(Clock::time_point now = Clock::now()) {
+    std::lock_guard<std::mutex> lock(_mutex);
+    if (!Check(now)) return {};
+    std::vector<Block> result(_blocks.begin(), _blocks.end());
+    _blocks.clear();
+    return result;
+  }
+private:
+  bool Check(Clock::time_point now) {
+    if (_enabled && now >= _expires) Fail();
+    return _enabled;
+  }
+  void Fail() { _failed = true; _enabled = false; _blocks.clear(); }
+  std::mutex _mutex;
+  std::deque<Block> _blocks;
+  Clock::time_point _expires{};
+  uint32_t _session = 0;
+  uint32_t _sequence = 0;
+  bool _enabled = false;
+  bool _failed = false;
+};
+}}}
+#endif
diff --git a/cloud/cloud/sdk_audio_test.go b/cloud/cloud/sdk_audio_test.go
new file mode 100644
index 00000000..526a30d1
--- /dev/null
+++ b/cloud/cloud/sdk_audio_test.go
@@ -0,0 +1,107 @@
+package main
+
+import (
+	"context"
+	extint "github.com/digital-dream-labs/vector-cloud/internal/proto/external_interface"
+	"github.com/golang/protobuf/proto"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"testing"
+	"time"
+)
+
+func micChunk(group, index uint32) *extint.AudioChunk {
+	return &extint.AudioChunk{GroupId: group, ChunkId: index, AudioChunkCount: 10, SignalPower: make([]byte, 320)}
+}
+func TestSDKAudioReassemblyRejectsMissingAndMalformedData(t *testing.T) {
+	cache := AudioFeedCache{GroupId: -1, LastChunkId: -1}
+	for i := uint32(0); i < 10; i++ {
+		if ready := UnpackAudioChunk(micChunk(0, i), &cache); ready != (i == 9) {
+			t.Fatalf("unexpected readiness at %d", i)
+		}
+	}
+	if cache.Size != 3200 {
+		t.Fatal("wrong PCM frame size")
+	}
+	ResetAudioCache(&cache)
+	UnpackAudioChunk(micChunk(1, 0), &cache)
+	if UnpackAudioChunk(micChunk(1, 2), &cache) {
+		t.Fatal("accepted missing chunk")
+	}
+	for i := uint32(0); i < 10; i++ {
+		UnpackAudioChunk(micChunk(2, i), &cache)
+	}
+	if cache.Invalid || cache.Size != 3200 {
+		t.Fatal("did not recover at next complete source group")
+	}
+	malformed := micChunk(3, 0)
+	malformed.SignalPower = make([]byte, 64000)
+	for _, chunk := range []*extint.AudioChunk{nil, malformed, micChunk(3, 100)} {
+		if UnpackAudioChunk(chunk, &cache) {
+			t.Fatal("accepted malformed data")
+		}
+	}
+}
+
+type micFakeConn struct {
+	modes chan extint.AudioProcessingMode
+}
+
+func (c *micFakeConn) Read() []byte      { return nil }
+func (c *micFakeConn) ReadBlock() []byte { return nil }
+func (c *micFakeConn) Close() error      { return nil }
+func (c *micFakeConn) Write(b []byte) (int, error) {
+	var w extint.GatewayWrapper
+	if err := proto.Unmarshal(b[2:], &w); err != nil {
+		return 0, err
+	}
+	c.modes <- w.GetAudioSendModeRequest().GetMode()
+	return len(b), nil
+}
+
+type micFakeStream struct {
+	grpc.ServerStream
+	ctx context.Context
+}
+
+func (s *micFakeStream) Context() context.Context             { return s.ctx }
+func (s *micFakeStream) Send(*extint.AudioFeedResponse) error { return nil }
+func TestSDKAudioCancelWithoutSamplesAndRepeatedOwnership(t *testing.T) {
+	conn := &micFakeConn{modes: make(chan extint.AudioProcessingMode, 16)}
+	oldConn, oldChannels := engineProtoManager.conn, engineProtoManager.managedChannels
+	engineProtoManager.conn = conn
+	engineProtoManager.managedChannels = make(map[string][]chan extint.GatewayWrapper)
+	defer func() { engineProtoManager.conn = oldConn; engineProtoManager.managedChannels = oldChannels }()
+	expect := func(want extint.AudioProcessingMode) {
+		t.Helper()
+		select {
+		case got := <-conn.modes:
+			if got != want {
+				t.Fatalf("mode %v, want %v", got, want)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("microphone control did not complete")
+		}
+	}
+	service := &rpcService{}
+	for attempt := 0; attempt < 3; attempt++ {
+		ctx, cancel := context.WithCancel(context.Background())
+		done := make(chan error, 1)
+		go func() { done <- service.AudioFeed(&extint.AudioFeedRequest{}, &micFakeStream{ctx: ctx}) }()
+		expect(extint.AudioProcessingMode_AUDIO_VOICE_DETECT_MODE)
+		if err := service.AudioFeed(&extint.AudioFeedRequest{}, &micFakeStream{ctx: ctx}); status.Code(err) != codes.ResourceExhausted {
+			t.Fatalf("overlap returned %v", err)
+		}
+		cancel()
+		expect(extint.AudioProcessingMode_AUDIO_OFF)
+		select {
+		case <-done:
+		case <-time.After(time.Second):
+			t.Fatal("cancel hung without mic samples")
+		}
+		if sdkAudioFeedActive || len(engineProtoManager.managedChannels) != 0 {
+			t.Fatal("microphone owner/listener leaked")
+		}
+	}
+}
